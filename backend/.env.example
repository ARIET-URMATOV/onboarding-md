# ─── Backend (FastAPI) ───
DATABASE_URL=postgresql+asyncpg://md:md_secret@localhost:5432/mdigital

JWT_SECRET_KEY=dev-secret-change-in-production
APP_ENV=development

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173

# ─── Stage 1 «Документы и доступы» ───
# Код MPulse на батч (fallback; приоритет — активный код из mpulse_codes через /admin)
MPULSE_VERIFICATION_CODE=ONBOARD-2026
# Динамическая проверка кода через API MPulse (пусто = выкл)
MPULSE_API_URL=
# Wi-Fi пароль по умолчанию (fallback; персональные — через /admin, шифр Fernet)
WIFI_PASSWORD=mdigital-wifi-2026
# Ключ шифрования персональных Wi-Fi паролей (сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
WIFI_ENCRYPTION_KEY=
# SSO корпоративного портала (пусто = auto-login отвечает 503)
SHARED_SECRET_KEY=
# Куда редиректить после auto-login
FRONTEND_URL=http://localhost:5173

# Ссылки внешних систем (пусто = только дефолты confluence/mpulse)
TELEGRAM_INVITE_LINK=
FIGMA_TEAM_URL=
CONFLUENCE_URL=https://confluence.mdigital.kg
MPULSE_ANDROID_URL=https://play.google.com/store/search?q=MPulse&c=apps
MPULSE_IOS_URL=https://apps.apple.com/search?term=MPulse
# API-инвайты (пусто = 501 + ссылка)
FIGMA_API_TOKEN=
TELEGRAM_BOT_TOKEN=

# SLA-уведомления (пусто = только лог)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=onboarding@mdigital.kg
HR_NOTIFY_EMAIL=

# ─── Active Directory / LDAP ───
# AD сервер (ldaps:// для SSL/TLS)
LDAP_SERVER_URI=ldap://ad.mdigital.local
# Service account для поиска пользователей
LDAP_BIND_DN=CN=service_account,OU=ServiceAccounts,DC=mdigital,DC=local
LDAP_BIND_PASSWORD=
# Base DN для поиска пользователей
LDAP_USER_SEARCH_BASE=CN=Users,DC=mdigital,DC=local
LDAP_GROUP_SEARCH_BASE=CN=Groups,DC=mdigital,DC=local

# ─── Demo ───
DEMO_EMAIL=demo@mdigital.kg
DEMO_PASSWORD=demo1234
DEMO_NAME=Demo User